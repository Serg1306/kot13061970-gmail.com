# Пример настроек сервера «Любовь в цифрах».
# Скопируйте в файл .env в корне проекта (рядом с package.json) и заполните.
# Строки, начинающиеся с #, — комментарии.

# Порт, на котором слушает сервер (nginx перенаправляет на него запросы)
PORT=8080
# Адрес, на котором слушать: 127.0.0.1 — только через nginx (рекомендуется), 0.0.0.0 — напрямую
HOST=127.0.0.1
# Папка для базы данных, фото и ключей (её нужно сохранять в резервные копии)
DATA_DIR=/var/lib/lyubov/data
# Адрес сайта для ссылок в письмах и push. Пока нет домена — http://IP-адрес-сервера
PUBLIC_URL=http://203.0.113.10

# Почты модераторов через запятую (им доступна страница /admin.html)
ADMIN_EMAILS=kot13061970@gmail.com

# Почта для кодов входа и уведомлений.
# Яндекс: smtp.yandex.ru, порт 465, логин — полный адрес, пароль — «пароль приложения»
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=robot@yandex.ru
SMTP_PASS=пароль-приложения
SMTP_FROM=Любовь в цифрах <robot@yandex.ru>
# Mail.ru: SMTP_HOST=smtp.mail.ru, SMTP_PORT=465, пароль для внешних приложений

# 1 — показывать код входа прямо на сайте (только для проверки, на рабочем сайте — 0!)
DEV_CODES=0
# 1 — фото публикуются без модерации
AUTO_APPROVE=0

# Push-уведомления выключены по умолчанию: это трансграничная передача данных (Google/Mozilla/Apple).
# Включайте (1) только после уведомления Роскомнадзора — см. docs/legal/02-uvedomlenie-rkn.md
PUSH_ENABLED=0
# Ключи можно не заполнять: при PUSH_ENABLED=1 сервер сам создаст их в DATA_DIR/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kot13061970@gmail.com

# Редакция текста согласий на обработку ПДн (дата). Меняйте, когда меняете тексты согласий
CONSENT_VERSION=2026-10-14

# Номер счётчика Яндекс Метрики (необязательно)
METRIKA_ID=

# Робокасса (подробно — docs/robokassa-setup.md)
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
ROBOKASSA_TEST=1
ROBOKASSA_HASH=md5
ROBOKASSA_RECEIPT=0
ROBOKASSA_SNO=
ROBOKASSA_TAX=none
# Адрес XML-интерфейса для сверки платежей — не меняйте (нужен только для автотестов)
# ROBOKASSA_XML_URL=https://auth.robokassa.ru/Merchant/WebService/Service.asmx

# Звонки: свой TURN-сервер для мобильных сетей (необязательно), JSON-список
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:203.0.113.10:3478","username":"lvc","credential":"пароль"}]
